HA_HOST=homeassistant.fritz.box
HA_USER=root
HA_PORT=22222
HA_CONFIG=/config
# AppDaemon Supervisor add-on ID: a0d7b954_appdaemon
# Path on HASS OS host for add-on apps directory.
# To find the correct path, run:
#   ssh root@homeassistant.fritz.box -p 22222 "find / -type d -name appdaemon 2>/dev/null"
# Common locations:
#   /mnt/data/supervisor/addons/config/a0d7b954_appdaemon/apps
#   /config/addons/a0d7b954_appdaemon/apps
#   /addons/config/a0d7b954_appdaemon/apps
APPDAEMON_APPS_DIR=/mnt/data/supervisor/addons/config/a0d7b954_appdaemon/apps
PKG_DIR=/config/packages
# Override if your logs are not at the default paths
# HA_LOG=/srv/homeassistant/ha/config/home-assistant.log
# AD_LOG=/srv/homeassistant/appdaemon/logs/appdaemon.log
